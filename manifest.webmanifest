{
  "name": "App Template",
  "short_name": "Template",
  "description": "A searchable local SVG icon library for finding and copying reusable interface symbols.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f5f3ed",
  "theme_color": "#f5f3ed",
  "orientation": "any",
  "categories": ["utilities"],
  "icons": [
    { "src": "assets/icons/icon-192.png?v=0.0.1.74", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png?v=0.0.1.74", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512-maskable.png?v=0.0.1.74", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
